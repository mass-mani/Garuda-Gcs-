# Generate with: openssl rand -hex 32
PUBLISHER_TOKEN=replace-with-a-random-secret

# Public HTTPS origin served by Caddy (no trailing slash)
PUBLIC_BASE_URL=https://live.example.com
PUBLIC_DOMAIN=live.example.com
PORT=8080
SESSION_TTL_HOURS=6
MAX_VIEWERS=3

# Direct peer connectivity is tried first. Coturn is optional.
STUN_URLS=stun:stun.l.google.com:19302
# TURN REST credentials: set these to match coturn's use-auth-secret/static-auth-secret.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_SECRET=another-long-random-secret
# TURN_REALM=turn.example.com
