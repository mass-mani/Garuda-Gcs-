<Window x:Class="Garuda.ControlRoom.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Garuda Live Viewer · Settings" Height="790" Width="1020" MinHeight="560" MinWidth="780"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="SETTINGS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="Split Screen Configuration" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0" />
            <TextBlock Text="Set the screen layout, enter RTSP or cloud playback URLs, and test the feeds before saving." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="140" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="Number of Rows" Foreground="#B7C6D4" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox x:Name="RowsCombo" Grid.Column="1" SelectionChanged="Layout_SelectionChanged" />
                <TextBlock Grid.Column="2" Text="Number of Columns" Foreground="#B7C6D4" VerticalAlignment="Center" Margin="20,0,10,0" />
                <ComboBox x:Name="ColumnsCombo" Grid.Column="3" SelectionChanged="Layout_SelectionChanged" />
                <DockPanel Grid.Column="4" LastChildFill="True">
                    <TextBlock x:Name="TotalInputs" DockPanel.Dock="Right" Text="1 video input" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    <CheckBox x:Name="AlwaysOnTopCheckBox" Content="Keep on top" ToolTip="Keep the Control Room window above other applications." VerticalAlignment="Center" />
                </DockPanel>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="CameraRowsPanel" />
        </ScrollViewer>
        <DockPanel Grid.Row="3" Margin="0,16,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" MinWidth="90" />
                <Button Content="Apply" Click="Apply_Click" Margin="0,0,8,0" MinWidth="90" />
                <Button Content="Save" Click="Save_Click" MinWidth="100" Background="#17695F" BorderBrush="#298A7F" />
            </StackPanel>
            <TextBlock Text="Settings are stored locally for this Windows user." Foreground="#71869A" FontSize="10" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
