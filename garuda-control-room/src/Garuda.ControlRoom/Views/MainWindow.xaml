<Window x:Class="Garuda.ControlRoom.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Garuda Live Viewer" Height="850" Width="1440" MinHeight="560" MinWidth="860"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown" Closing="MainWindow_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#0E1722" BorderBrush="#243448" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SettingsButton" Content="⚙  Settings" Click="Settings_Click" IsEnabled="False" />
                    <Button x:Name="ReconnectButton" Content="↻  Reconnect all" Click="Reconnect_Click"
                            Margin="8,0,0,0" Padding="12,8" IsEnabled="False"
                            ToolTip="Restart all configured RTSP connections" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="/Garuda.LiveViewer;component/Assets/GarudaMark.png"
                           Width="40" Height="40" Stretch="Uniform" VerticalAlignment="Center"
                           SnapsToDevicePixels="True" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Garuda Live Viewer" Foreground="{StaticResource TextBrush}"
                                   FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="LIVE VIDEO MONITORING" Foreground="#8FA2B5"
                                   FontSize="9" FontWeight="Bold" Margin="1,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="LayoutLabel" Grid.Column="2" Text="1 × 1" Foreground="#9EB0C1"
                           FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>
        <Grid x:Name="VideoGrid" Grid.Row="1" Margin="9" />
        <Border Grid.Row="2" Background="#0E1722" BorderBrush="#243448" BorderThickness="0,1,0,0">
            <DockPanel Margin="14,0">
                <TextBlock Text="CLOUD + NETWORK VIDEO MONITOR" Foreground="#71869A" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock x:Name="StreamSummary" Text="Starting…" Foreground="#91A5B8" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
