<UserControl x:Class="Garuda.ControlRoom.Views.HostedPlayerTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="220" MinHeight="150">
    <Border BorderBrush="#26384C" BorderThickness="1" Background="#05080C" CornerRadius="5" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#0E1722" Padding="11,4">
                <DockPanel LastChildFill="False">
                    <TextBlock x:Name="NameLabel" Foreground="#E8F0F5" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="OPEN PLAYER" Padding="9,5" FontSize="10" FontWeight="Bold" ToolTip="Open the hosted player page in your default browser" Click="OpenPlayer_Click" />
                    <Ellipse x:Name="StatusDot" DockPanel.Dock="Right" Width="8" Height="8" Fill="#F1BA53" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusLabel" DockPanel.Dock="Right" Text="LOADING" Foreground="#F1BA53" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                </DockPanel>
            </Border>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="430" Margin="22">
                <TextBlock Text="HOSTED CLOUD PLAYER" Foreground="#E8F0F5" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="This provider page opens in your default browser. Use a direct HLS .m3u8 URL to play video inside this grid." Foreground="#91A5B8" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="10,8,10,0" />
            </StackPanel>
            <TextBlock x:Name="DetailLabel" Grid.Row="1" Text="" Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
