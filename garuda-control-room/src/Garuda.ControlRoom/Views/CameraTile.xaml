<UserControl x:Class="Garuda.ControlRoom.Views.CameraTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             MinWidth="220" MinHeight="150">
    <Border BorderBrush="#26384C" BorderThickness="1" Background="#05080C" CornerRadius="5" ClipToBounds="True">
        <vlc:VideoView x:Name="VideoSurface">
            <!-- LibVLCSharp.WPF renders this content in a transparent overlay window.
                 Keep the overlay almost transparent so it does not cover the VLC HWND. -->
            <Grid Background="#02000000" MouseLeftButtonDown="Tile_MouseLeftButtonDown">
                <StackPanel x:Name="NoSignalOverlay" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="NO VIDEO" Foreground="#AFC0CF" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Waiting for video" Foreground="#93A7BA" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>
                <Border VerticalAlignment="Top" Background="#D90B1018" Padding="11,8">
                    <DockPanel LastChildFill="False">
                        <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Name}" Foreground="#E8F0F5" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="⛶" Padding="8,3" FontSize="16" ToolTip="Toggle full screen" Click="FullScreen_Click" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    </DockPanel>
                </Border>
                <TextBlock Text="{Binding Detail}" Foreground="{Binding StatusBrush}" Background="#BA0B1018" Padding="10,5" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="9" />
            </Grid>
        </vlc:VideoView>
    </Border>
</UserControl>
